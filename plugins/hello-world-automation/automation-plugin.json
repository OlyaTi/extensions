{
  "schema_version": "openhands.automation.plugin.v1",
  "name": "hello-world-automation",
  "description": "A minimal plugin-backed automation using the stock conversation runner.",
  "entrypoint": {
    "runner": "conversation",
    "command": "hello"
  },
  "runtime": {
    "agent_profile": {
      "required": true,
      "default_name": "hello-world-agent",
      "allowed_tools": [
        "terminal"
      ]
    },
    "plugins": []
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "message": {
        "type": "string",
        "default": "Hello from the automation plugin"
      }
    }
  }
}
